# DocGen CLI Environment Configuration
# Copy this file to .env and customize the values as needed

# Server Configuration
PORT=3000

# DocGen API Configuration
API_BASE=https://us-wordaddinbff.sharefiletest.io/io/docgen

# Authentication Configuration
AUTH_URI=https://auth.sharefiletest.io
CLIENT_ID=ShareFileWordAddInClient
SCOPE=wordaddinbff:api.full

# Security Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
REQUEST_TIMEOUT=30000   # 30 seconds
ALLOWED_ORIGINS=https://localhost:3000

# Logging Configuration
LOG_LEVEL=info          # error, warn, info, debug
MAX_LOG_SIZE=104857600  # 100MB in bytes

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_TIMEOUT=60000    # 60 seconds

# Development/Production Settings
NODE_ENV=development
